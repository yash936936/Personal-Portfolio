{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contact-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-22",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://personal-portfolio-yashmalik.vercel.app",
    "REQUIRE_TURNSTILE": "false"
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "92746123",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "CONTACT_IP_RATE_LIMITER",
      "namespace_id": "92746124",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
