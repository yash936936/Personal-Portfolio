# Optional override for local Worker development.
# Omit this variable in production to use the default deployed Worker URL.
VITE_CONTACT_API_URL=http://127.0.0.1:8787

# Optional. Set this to the exact domain registered in Plausible.
# Analytics stays disabled when this value is empty.
VITE_PLAUSIBLE_DOMAIN=

# Optional. Configure this public sitekey together with:
# REQUIRE_TURNSTILE=true and TURNSTILE_SECRET_KEY in the Cloudflare Worker.
VITE_TURNSTILE_SITE_KEY=
